# Temporary Files, Logs & Diagnostics
# -----------------------------------
*.tmp
*.temp
*.log
*.bak
*.old
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Burp Suite Temporary State / Saved Projects (exclude large state files if saved locally)
# ----------------------------------------------------------------------------------------
*.burp
*.burp.*
burp.log

# Explicitly ensure required deliverables and media are NOT ignored
# ------------------------------------------------------------------
!report/
!presentation/
!screenshots/
!screenshots/**
!*.pdf
!*.docx
!*.pptx
!*.png
!*.jpg
!*.jpeg
