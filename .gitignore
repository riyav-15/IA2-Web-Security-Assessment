# --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cer
*.crt

# Python Caches & Environments (if applicable)
# ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
